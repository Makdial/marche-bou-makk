{
  "name": "marche-bou-makk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Marche Bou Makk: multi-vendor marketplace and delivery app for Senegal (admin, store, shopper and conductor apps)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/api.test.ts",
    "db:reset": "tsx src/server/scripts/reset-db.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.18.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "~5.9",
    "vite": "^8.3.5"
  }
}
