# Copy to .env and change the secrets before deploying.

# API port (the web app in development runs on 5173 and proxies /api here)
PORT=4000

# Set to "production" when serving the built app
NODE_ENV=development

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Currency: XOF is the West African CFA franc (FCFA), shown in whole francs
CURRENCY=XOF

# Map center for demo data and maps: Dakar, Senegal
MARKET_CENTER_LAT=14.6928
MARKET_CENTER_LNG=-17.4467

# Load demo stores, shoppers and conductors on an empty database (default: on outside production)
# SEED_DEMO=false

# Admin account created on first start
ADMIN_EMAIL=admin@market.local
ADMIN_PASSWORD=admin1234

# Where the SQLite database and uploaded photos are stored
# DATA_DIR=./data
